    %% Tương tác Khách Vãng Lai
    Guest --> UC_DuyetSP
    Guest --> UC_GoiYSize
    Guest --> UC_XemBlog
    Guest --> UC_ChatGuest
    Guest --> UC_DangKy
    UC_DangKy -.->|<<include>>| UC_XacThucOTP

    %% Tương tác Khách Hàng
    Customer --> UC_DatHang
    UC_DatHang -.->|<<include>>| UC_GiamGiaVIP
    UC_DatHang -.->|<<include>>| UC_GoiYSize
    Customer --> UC_TheoDoiDon
    UC_TheoDoiDon -.->|<<extend>>| UC_DanhGia
    UC_TheoDoiDon -.->|<<include>>| UC_TichDiem
    Customer --> UC_DangKyKOL
    Customer --> UC_TuongTacBlog

    %% Tương tác Nhân Viên
    Staff --> UC_TiepNhanDon
    Staff --> UC_TrucChat
    Staff --> UC_DuyetKOL
    UC_TiepNhanDon -.->|<<include>>| UC_TichDiem

    %% Tương tác Admin
    Admin --> UC_QuanLyKho
    Admin --> UC_QuanLyDanhMuc
    Admin --> UC_CauHinhVIP
    Admin --> UC_QuanLyBanner
    Admin --> UC_KiemDuyet
    Admin --> UC_XemBaoCao
    Admin --|> Staff

