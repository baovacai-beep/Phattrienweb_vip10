# =========================================================================
# FASHIONKIDS - CẤU HÌNH API TÍCH HỢP (.env.example)
# Sao chép file này thành ".env" cùng thư mục rồi điền các Key của bạn.
# Tuyệt đối KHÔNG commit file ".env" lên Git công khai!
# =========================================================================

# 1. GIAO HÀNG NHANH (GHN) - Tính phí ship thực tế & Đẩy mã vận đơn
# Lấy tại: https://khachhang.ghn.vn/ -> Quản lý cửa hàng / Token API
GHN_TOKEN=
GHN_SHOP_ID=
# Mặc định Quận 1, TP.HCM (1442) - Phường Bến Nghé (20101) nếu chưa cấu hình
GHN_FROM_DISTRICT_ID=1442
GHN_FROM_WARD_CODE=20101
# Đặt true để dùng Sandbox GHN (dev-online-gateway.ghn.vn), false cho Production
GHN_SANDBOX=true

# Khóa bí mật xác thực Webhook trạng thái vận đơn (tùy chọn cho demo/webhook đối tác)
# Endpoint webhook: http://localhost/FashionKids/index.php?c=order&a=shippingWebhook
SHIPPING_WEBHOOK_SECRET=fk_webhook_demo_secret_2026

# 2. GOOGLE OAUTH 2.0 (Đăng nhập nhanh bằng tài khoản Google)
# Lấy tại: https://console.cloud.google.com/ -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost/FashionKids/index.php?c=auth&a=googleCallback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Để trống để hệ thống tự suy ra theo host hiện tại
GOOGLE_REDIRECT_URI=

# 3. CLOUDFLARE TURNSTILE (Chống spam OTP / Login / Casting KOL Nhí)
# Lấy tại: https://dash.cloudflare.com/ -> Turnstile -> Add site
# Nếu để trống, form vẫn hoạt động bình thường trên localhost để test mượt.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 4. GOOGLE GEMINI API (Trợ lý AI Tư vấn Size & Chất liệu Sợi Tre 24/7)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# 5. THƯ MỚI / EMAIL & THANH TOÁN (Tùy chọn ghi đè config/app.php & config/payment.php)
# APP_BASE_URL=/FashionKids
# SMTP_USER=
# SMTP_PASS=
# CASSO_API_KEY=
